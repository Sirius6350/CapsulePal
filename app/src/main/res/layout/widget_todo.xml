<?xml version="1.0" encoding="utf-8"?>
<!-- 今日待办：完成进度 + 离现在最近的几条待办。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_todo_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日待办"
                android:textColor="@color/widget_ink_soft"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_todo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0/0"
                android:textColor="@color/widget_ink"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_todo_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/widget_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_todo_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/widget_todo_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="今天还没有安排"
        android:textColor="@color/widget_ink_soft"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_todo_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_todo_time_1"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_todo_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_todo_time_2"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_todo_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_todo_time_3"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_todo_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_todo_time_4"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_todo_title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_todo_time_5"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_todo_title_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_todo_row_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_todo_time_6"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_todo_title_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
