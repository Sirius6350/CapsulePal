<?xml version="1.0" encoding="utf-8"?>
<!-- 电量与温度（竖版）：适合 2x3 / 2x4 等高瘦尺寸，电量环在上、数据在下。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_metric_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_metric_ring"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/widget_metric_label" />

    <LinearLayout
        android:id="@+id/widget_metric_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_metric_temp_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="电池温度"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_metric_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_metric_charge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:text="今日充电"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_metric_charge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="0 次"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
